# Copy to .env on the server and fill in real values. Never commit .env.

NUMZSCAN_DB_USER=numzscan
NUMZSCAN_DB_PASSWORD=changeme
NUMZSCAN_DB_NAME=numzscan
NUMZSCAN_HTTP_PORT=3210

# Discovered via: docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# Do not hardcode a literal here without re-discovering it on this host first.
NUMZSCAN_GATEWAY_BIND_IP=172.17.0.1

# Comma-separated list of allowed cross-origin callers. Leave blank when the
# frontend is served same-origin from this container (no CORS headers at all).
NUMZSCAN_CORS_ORIGIN=

# EventPass API v1 is mounted only when EVENTPASS_TOKEN_KEY is set. It HMACs credential
# and scanner secrets, so it must be a random value of at least 32 characters, kept out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave it blank to keep the legacy surface only.
EVENTPASS_TOKEN_KEY=
# Optional tuning, with defaults shown:
# EVENTPASS_SESSION_TTL_HOURS=12
# EVENTPASS_LOGIN_LIMIT=20
# EVENTPASS_API_LIMIT=600
# Public registration (no sign-in) is limited per address and per minute. Visitors behind one shared network
# share that address, so keep this generous enough for a whole church arriving at once.
# EVENTPASS_PUBLIC_REGISTRATION_LIMIT=120
# The public address people reach EventPass on, with no trailing path. Registration links and QR codes are
# built from it. Leave blank and the manager sees no link until it is set.
# EVENTPASS_PUBLIC_URL=https://events.example.org
# Set to false only for local HTTP development. Browsers drop Secure cookies over plain HTTP.
# EVENTPASS_COOKIE_SECURE=true
